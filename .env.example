# Copiar a .env para personalizar. No incluir contraseñas en este archivo.
PORT=3000
HOST=0.0.0.0
# URL pública HTTPS cuando se publique. En local dejar vacío.
PUBLIC_URL=
# Activar detrás de un proxy HTTPS. No activar en HTTP local.
SECURE_COOKIES=false
# Carpeta privada fuera de public, con disco persistente.
DATA_DIR=./data
